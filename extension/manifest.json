{
  "manifest_version": 3,
  "name": "TN Tool",
  "version": "0.1.0",
  "description": "Hỗ trợ nhiệm vụ ngày Tiên Nghịch",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://tiennghich.joyplay.vn/*",
    "https://tiennghich.acejoygame.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TN Tool",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
